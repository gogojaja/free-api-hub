# 非生产环境示例（dev/test 共用平台，逻辑细分）
# 密钥只存别名，真实值经 .secrets/ 注入，禁止明文入库
FREE_API_HUB_ENV=nonprod
GATEWAY_HOST=http://localhost:30000
ADMIN_HOST=http://localhost:30001
STATE_STORE=sqlite://./environments/nonprod/dev/state.db
# 各 provider key 别名（真实文件 ~/.config/opencode/<provider>-api-key）
DEEPSEEK_KEY_ALIAS={file:~/.config/opencode/deepseek-api-key}
SILICONFLOW_KEY_ALIAS={file:~/.config/opencode/siliconflow-api-key}
ZHIPU_KEY_ALIAS={file:~/.config/opencode/zhipu-api-key}
BAILIAN_KEY_ALIAS={file:~/.config/opencode/bailian-api-key}
OPENROUTER_KEY_ALIAS={file:~/.config/opencode/openrouter-api-key}
