# Free API Hub — 聊天实例配置
# 通用对话 / 轻量任务
# 优先使用国内免费提供商，海外 OpenRouter 兜底

gateway:
  port: 5080
  retry_seconds: 15
  timeout: 30
  log: data/chat.log

providers:
  - name: siliconflow
    display: 硅基流动
    endpoint: https://api.siliconflow.cn/v1
    model: Qwen/Qwen2.5-72B-Instruct
    priority: 1
    api_key: 您的硅基流动 API Key
    note: 注册 https://siliconflow.cn 获取 Key，免费模型含 Qwen2.5-72B/DeepSeek-V3/GLM-4

  - name: zhipu
    display: 智谱AI
    endpoint: https://open.bigmodel.cn/api/paas/v4
    model: glm-4-flash
    priority: 2
    api_key: 您的智谱 API Key
    note: 注册 https://open.bigmodel.cn 获取 Key，glm-4-flash 免费

  - name: deepseek
    display: DeepSeek
    endpoint: https://api.deepseek.com/v1
    model: deepseek-chat
    priority: 3
    api_key: 您的 DeepSeek API Key
    note: 注册 https://platform.deepseek.com 获取 Key，注册送 500 万 token

  - name: openrouter
    display: OpenRouter (海外兜底)
    endpoint: https://openrouter.ai/api/v1
    model: openrouter/free
    priority: 10
    api_key: OPENROUTER_API_KEY_REPLACED
    headers:
      HTTP-Referer: http://localhost:5080
      X-Title: Free-API-Hub
