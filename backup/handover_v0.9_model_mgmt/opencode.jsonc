{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5:7b",
  "disabled_providers": [
    "deepseek"
  ],
  "provider": {
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{file:~/.config/opencode/opencode-api-key}"
      },
      "whitelist": [
        "big-pickle",
        "deepseek-v4-flash-free",
        "hy3-free",
        "mimo-v2.5-free",
        "muse-spark-1.2-contributor-free",
        "nemotron-3-ultra-free",
        "nemotron-3.5-lightning-free"
      ],
      "models": {
        "big-pickle": {
          "name": "(free) big-pickle",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "deepseek-v4-flash-free": {
          "name": "(free) deepseek-v4-flash-free",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "hy3-free": {
          "name": "(free) hy3-free",
          "tool_call": true,
          "limit": {
            "context": 190000,
            "output": 64000
          }
        },
        "mimo-v2.5-free": {
          "name": "(free) mimo-v2.5-free",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "muse-spark-1.2-contributor-free": {
          "name": "(free) muse-spark-1.2-contributor-free",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "nemotron-3-ultra-free": {
          "name": "(free) nemotron-3-ultra-free",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "nemotron-3.5-lightning-free": {
          "name": "(free) nemotron-3.5-lightning-free",
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 262144
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "whitelist": [
        "qwen2.5:7b",
        "qwen2.5-coder:7b"
